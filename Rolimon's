@charset "utf-8";

.spinner { -webkit-box-align: center; -webkit-box-pack: center; align-items: center; display: flex; justify-content: center; }

.spinner-inner { display: inline-block; height: 32px; position: relative; width: 32px; }

.spinner-wandering-cubes .spinner-item { animation: 1.8s ease-in-out 0s infinite normal none running spinner-wandering-cubes; background-color: rgb(114, 137, 218); height: 10px; left: 0px; position: absolute; top: 0px; width: 10px; }

.spinner-wandering-cubes .spinner-item:last-child { animation-delay: -0.9s; }

@-webkit-keyframes spinner-wandering-cubes { 
  25% { transform: translateX(22px) rotate(-90deg) scale(0.5); }
  50% { transform: translateX(22px) translateY(22px) rotate(-180deg); }
  75% { transform: translateX(0px) translateY(22px) rotate(-270deg) scale(0.5); }
  100% { transform: rotate(-1turn); }
}

@keyframes spinner-wandering-cubes { 
  25% { transform: translateX(22px) rotate(-90deg) scale(0.5); }
  50% { transform: translateX(22px) translateY(22px) rotate(-180deg); }
  75% { transform: translateX(0px) translateY(22px) rotate(-270deg) scale(0.5); }
  100% { transform: rotate(-1turn); }
}

.spinner-chasing-dots { animation: 2s linear 0s infinite normal none running spinner-chasing-dots-rotate; }

.spinner-chasing-dots .spinner-item { animation: 2s ease-in-out 0s infinite normal none running spinner-chasing-dots-bounce; background-color: rgb(114, 137, 218); border-radius: 100%; display: inline-block; height: 60%; position: absolute; top: 0px; width: 60%; }

.spinner-chasing-dots .spinner-item:last-child { animation-delay: -1s; bottom: 0px; top: auto; }

@-webkit-keyframes spinner-chasing-dots-rotate { 
  100% { transform: rotate(1turn); }
}

@keyframes spinner-chasing-dots-rotate { 
  100% { transform: rotate(1turn); }
}

@-webkit-keyframes spinner-chasing-dots-bounce { 
  0%, 100% { transform: scale(0); }
  50% { transform: scale(1); }
}

@keyframes spinner-chasing-dots-bounce { 
  0%, 100% { transform: scale(0); }
  50% { transform: scale(1); }
}

.spinner-pulsing-ellipsis { -webkit-box-pack: center; display: flex; height: auto; justify-content: center; position: relative; width: 28px; }

.spinner-pulsing-ellipsis .spinner-item { animation: 1.4s ease-in-out 0s infinite normal none running spinner-ellipsis; background-color: rgb(153, 170, 181); border-radius: 3px; display: inline-block; height: 6px; margin-right: 2px; opacity: 0.3; width: 6px; }

.spinner-pulsing-ellipsis .spinner-item:nth-of-type(2) { animation-delay: 0.2s; }

.spinner-pulsing-ellipsis .spinner-item:nth-of-type(3) { animation-delay: 0.4s; }

.stop-animation .spinner-pulsing-ellipsis .spinner-item { animation: auto ease 0s 1 normal none running none; }

@-webkit-keyframes spinner-ellipsis { 
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(0.8); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes spinner-ellipsis { 
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(0.8); }
  100% { opacity: 1; transform: scale(1); }
}

