@charset "utf-8";

p { font-size: 10pt; }

body, div, p, td, th, ul, ol, li { margin: 0px; padding: 0px; }

body { background-color: rgb(255, 255, 255); font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }

img { border: none; }

a { color: rgb(0, 102, 153); }

.clearfix { width: 100%; clear: both; }

.clearfix::after { content: "."; display: block; height: 0px; clear: both; visibility: hidden; }

.view-navbar { text-align: center; font-size: 17px; }

.view-navbar a { text-decoration: underline; }

.view-navbar > li { list-style: none; display: inline-block; padding: 0px 20px; }

#positionHome { padding: 0px; margin: 55px auto 30px; width: 450px; background-color: rgb(255, 255, 255); overflow: visible; }

#searchHome { text-align: center; margin-bottom: 60px; width: 450px; position: relative; }

#searchHome input[type="text"] { font-family: Arial, Helvetica, sans-serif; font-size: 1.125em; font-weight: 700; width: 440px; }

#searchHome button { font-family: "Lucida Sans", "Lucida Grande", Arial, sans-serif; font-size: 1em; display: block; margin: 5px auto; }

#searchAdvHome { position: absolute; left: 460px; top: 8px; font-size: 0.75em; white-space: nowrap; }

#introHome { margin-bottom: 15px; }

#introHome h2 { font-family: Arial, Helvetica, sans-serif; font-size: 1.5em; margin: 0px; padding: 0px; line-height: normal; color: rgb(0, 174, 240); }

#introHome p { font-size: 1.25em; line-height: 1.5em; }

#introHome a.faq { font-size: 0.875em; display: block; text-align: right; line-height: 1.5em; }

#footerHome { max-width: 413px; text-align: left; margin: 45px auto 0px; padding-left: 37px; background: url("../images/logo_archive-sm.png") 0px 0px no-repeat; }

#footerHome p { font-family: georgia, "times new roman", serif; font-size: 0.6875em; color: rgb(102, 102, 102); line-height: 1.5em; margin-bottom: 2em; }

.no-script-message { width: 400px; margin: 200px auto; text-align: center; }

.search-toolbar-logo { background-image: url("../images/toolbar/wayback-toolbar-logo.svg"); background-size: 183px; background-repeat: no-repeat; background-position: center center; width: 204px; height: 72px; display: inline-block; }

body.wb_embedded { display: none !important; }

#error { min-height: 230px; }

#error h2 { font-size: 1.5em; margin: 0px 0px 20px; padding: 0px; line-height: normal; color: rgb(238, 28, 36); }

#error h2.blue { color: rgb(0, 174, 240) !important; }

#error p { font-size: 1em; line-height: 1.5em; }

#error p.target { white-space: pre-line; word-break: break-all; overflow-wrap: break-word; }

#errorBorder { border-bottom: 1px solid rgb(204, 204, 204); width: 780px; margin: 0px auto; }

#error p.code { font-family: "Andale Mono", "Lucida Console", "Courier New", monospace; margin: 0px 0px 1.5em; }

#error p.shift { padding-left: 35px; }

#error .red { color: rgb(238, 28, 36); }

#error p.impatient { font-family: Georgia, "Times New Roman", serif; font-size: 0.75em; margin: 0px 0px 1.5em 450px; white-space: nowrap; }

.error-text { font-size: 120%; margin-bottom: 0.5em; }

.error-help { padding: 20px; margin: 20px 0px; border-radius: 10px; box-shadow: rgb(170, 170, 170) 0px 0px 8px 5px; }

.error-help-action { text-align: center; margin-top: 8px; }

.error-help-proceed { border: 1px solid rgb(0, 255, 0); }

.error-help-stop { border: 1px solid rgb(255, 0, 0); }

#livewebInfo.available { background: rgb(255, 255, 224); }

#livewebInfo #spn-form { margin-top: 7px; }

.feedback_button { float: right; font-weight: bold; margin: 102px -50px 0px 0px; transform: rotate(270deg); }

.social_button { display: block; border: none !important; margin: 1px 0px !important; padding: 0px !important; }

.social_button:hover, .social_button:focus { border: none !important; text-decoration: none !important; }

#spn-title { overflow-wrap: break-word; }
